{
  "name": "mnemo",
  "version": "0.1.5",
  "description": "Mnemo — local-first Markdown second-brain fed from AI chat via MCP",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mnemo": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.json && vite build",
    "build": "npm run prepare",
    "dev": "vite",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@inquirer/prompts": "^8.7.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "chokidar": "^4.0.3",
    "commander": "^15.0.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.5",
    "markdown-it": "^15.0.1",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "minisearch": "^7.2.0",
    "open": "^11.0.2",
    "picocolors": "^1.1.1",
    "proper-lockfile": "^4.1.2",
    "sanitize-html": "^2.17.7",
    "shiki": "^4.4.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.102.8",
